# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
showtrack-*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# IDE
.idea
# Large GTFS raw files
gtfs-data/obb/shapes.txt
gtfs-data/polish_trains.zip
gtfs-data/polish-trains-unpacked/
.env*.local

# Playwright
.playwright-mcp/
.playwright-cli/
# Downloaded GTFS feeds unpacked by the scrape (regenerated each run)
gtfs-data/*-unpacked/
# Streamed straight out of the zip instead (trafiklab: 650 MB, deleted after use)
gtfs-data/*.zip

# Playwright output (the HTML report, and the screenshots the specs write)
/playwright-report/
/tests/screenshots/

# Ad-hoc dev screenshots. preview.png is the exception — README embeds it.
/*.png
!/preview.png
